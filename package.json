{
  "name": "focus-orb",
  "productName": "Focus Orb",
  "version": "1.0.0",
  "description": "桌面悬浮球番茄钟",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "Focus Orb contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yiyuezhixia-oss/focus-orb.git"
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.focusorb.app",
    "productName": "Focus Orb",
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "artifactName": "FocusOrb-${version}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ]
  }
}
